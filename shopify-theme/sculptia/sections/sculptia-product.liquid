{{ 'sculptia-product.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;900&family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

{%- assign color_option_index = -1 -%}
{%- assign size_option_index = -1 -%}
{%- for opt in product.options_with_values -%}
  {%- assign opt_name_down = opt.name | downcase -%}
  {%- if opt_name_down contains 'color' or opt_name_down contains 'couleur' -%}
    {%- assign color_option_index = forloop.index0 -%}
  {%- endif -%}
  {%- if opt_name_down contains 'size' or opt_name_down contains 'taille' -%}
    {%- assign size_option_index = forloop.index0 -%}
  {%- endif -%}
{%- endfor -%}

<div class="scp-root" id="scp-root"
     data-color-option-index="{{ color_option_index }}"
     data-size-option-index="{{ size_option_index }}"
     data-product-handle="{{ product.handle }}">

  <div class="scp-announce">{{ section.settings.announcement | default: "FREE SHIPPING OVER $65 · BUY 2 GET 1 FREE — TODAY ONLY" }}</div>

  <section class="scp-hero" id="scp-top">
    <div>
      <div class="scp-gallery-main"><img id="scp-gallery-main-img" src="{{ 'sculptia-colorway-black.jpg' | asset_url }}" alt="{{ product.title }}"></div>
      <div class="scp-gallery-thumbs" id="scp-gallery-thumbs"></div>
    </div>
    <div>
      <span class="scp-badge">{{ section.settings.badge_text | default: "Best-Seller" }}</span>
      <h1 class="scp-title">{{ product.title }}</h1>

      <div class="scp-rating-row">
        <div class="scp-stars" id="scp-stars-hero"></div>
        <span class="scp-rating-num">{{ section.settings.review_average | default: 4.7 }}</span>
        <a class="scp-rating-link" href="#scp-reviews">({{ section.settings.review_count | default: 355 }} reviews)</a>
      </div>

      <div class="scp-price-row">
        <span class="scp-price-now scp-num" id="scp-price-now">{{ product.selected_or_first_available_variant.price | money }}</span>
        {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
          <span class="scp-price-was" id="scp-price-was">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
          <span class="scp-price-save" id="scp-price-save"></span>
        {%- endif -%}
      </div>

      <ul class="scp-bullets">
        {%- for line in section.settings.benefit_bullets | newline_to_br | split: '<br />' -%}
          {%- assign trimmed = line | strip -%}
          {%- if trimmed != blank -%}<li><span class="scp-check">✓</span>{{ trimmed }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if color_option_index > -1 -%}
      <div class="scp-field">
        <span class="scp-field-label">{{ product.options[color_option_index] | upcase }}: <b id="scp-color-label"></b></span>
        <div class="scp-color-row" id="scp-color-row"></div>
      </div>
      {%- endif -%}

      {%- if size_option_index > -1 -%}
      <div class="scp-field">
        <span class="scp-field-label">{{ product.options[size_option_index] | upcase }}: <b id="scp-size-label"></b></span>
        <div class="scp-size-row" id="scp-size-row"></div>
      </div>
      {%- endif -%}

      <div class="scp-urgency">{{ section.settings.urgency_text | default: "OFFER ENDS TONIGHT" }} <span class="scp-dot">·</span> <span class="scp-num" id="scp-countdown">29:35</span></div>

      <div class="scp-bundles" id="scp-bundles"></div>

      <button class="scp-cta" id="scp-cta-main" type="button">
        ADD TO CART · <span class="scp-num" id="scp-cta-price"></span>
      </button>
      <p class="scp-cta-note" id="scp-cta-note"></p>
      <p class="scp-microcopy" id="scp-stock-note">In stock · Free shipping · 30-day refund</p>

      <div class="scp-trust-row">
        <div>{% render 'scp-icon-truck' %}Free shipping $65+</div>
        <div>{% render 'scp-icon-return' %}30-day returns</div>
        <div>{% render 'scp-icon-shield' %}Secure checkout</div>
      </div>
    </div>
  </section>

  <section class="scp-promise">
    <p class="scp-eyebrow">THE {{ shop.name | upcase }} PROMISE</p>
    <h2>{{ section.settings.promise_title | default: "Sculpt Your Silhouette" }}</h2>
    <p>{{ section.settings.promise_text | default: "One legging changes everything: it shapes, lifts, and smooths from the very first wear." }}</p>
  </section>

  <section class="scp-chapter">
    <div class="scp-chapter-media"><img src="{{ 'sculptia-lifestyle-yoga.jpg' | asset_url }}" alt="" loading="lazy"></div>
    <div class="scp-chapter-copy">
      <p class="scp-eyebrow scp-accent">THE RESULT</p>
      <h2>A visibly more sculpted silhouette</h2>
      <p>The high waistband shapes your tummy, the back panels lift your glutes, and the compression slims your thighs.</p>
      <ul class="scp-bullets">
        <li><span class="scp-check">✓</span>Visibly slimmer waist</li>
        <li><span class="scp-check">✓</span>Lifted, rounder glutes</li>
        <li><span class="scp-check">✓</span>Smoother thighs, no marks</li>
      </ul>
    </div>
  </section>

  <section class="scp-chapter scp-reverse">
    <div class="scp-chapter-media"><img src="{{ 'sculptia-lifestyle-couch.jpg' | asset_url }}" alt="" loading="lazy"></div>
    <div class="scp-chapter-copy">
      <p class="scp-eyebrow scp-accent">THE MECHANISM</p>
      <h2>3D structure makes the difference</h2>
      <ul class="scp-rich-bullets">
        <li><b>Honeycomb mesh.</b> <span>Raised cells create a micro-massage with every step.</span></li>
        <li><b>Contoured panels.</b> <span>Lift your glutes like an invisible hand.</span></li>
        <li><b>Graduated compression.</b> <span>Firm at the waist, flexible at the knee.</span></li>
      </ul>
    </div>
  </section>

  <section class="scp-chapter">
    <div class="scp-chapter-media"><img src="{{ 'sculptia-colorway-gray-chine.jpg' | asset_url }}" alt="" loading="lazy"></div>
    <div class="scp-chapter-copy">
      <p class="scp-eyebrow scp-accent">CIRCULATION</p>
      <h2>Fabric that massages with every move</h2>
      <p>3D drainage lines boost circulation and lymphatic drainage from the moment you put them on.</p>
      <ul class="scp-rich-bullets">
        <li><b>Without Sculptia.</b> <span>Sluggish circulation, stubborn cellulite.</span></li>
        <li><b>With Sculptia.</b> <span>Boosted circulation, smoother skin.</span></li>
      </ul>
    </div>
  </section>

  <section class="scp-chapter scp-reverse">
    <div class="scp-chapter-media"><img src="{{ 'sculptia-colorway-navy.jpg' | asset_url }}" alt="" loading="lazy"></div>
    <div class="scp-chapter-copy">
      <p class="scp-eyebrow scp-accent">THE WAISTBAND</p>
      <h2>High waist, flat tummy</h2>
      <p>The wide waistband holds your tummy gently in place and shapes your silhouette — without ever rolling down.</p>
      <ul class="scp-bullets">
        <li><span class="scp-check">✓</span>Gentle, secure hold</li>
        <li><span class="scp-check">✓</span>Never rolls, never slips</li>
        <li><span class="scp-check">✓</span>Naturally flattering shape</li>
      </ul>
    </div>
  </section>

  <section class="scp-chapter">
    <div class="scp-chapter-media"><img src="{{ 'sculptia-colorway-charcoal.jpg' | asset_url }}" alt="" loading="lazy"></div>
    <div class="scp-chapter-copy">
      <p class="scp-eyebrow scp-accent">YOUR SKIN</p>
      <h2>Visibly smoother-looking skin</h2>
      <p>The textured mesh stimulates your skin with every move. The look of dimpled skin visibly fades.</p>
    </div>
  </section>

  <div class="scp-timeline">
    <div class="scp-timeline-row">
      <div class="scp-timeline-step"><div class="t">Day 1</div><div class="d">Instant lift</div></div>
      <div class="scp-timeline-step"><div class="t">2 wks</div><div class="d">Firmer skin</div></div>
      <div class="scp-timeline-step"><div class="t">4 wks</div><div class="d">Smoother look</div></div>
    </div>
  </div>

  <section class="scp-features">
    <div class="scp-feature-grid">
      <div class="scp-feature-card"><h3>Never rolls down</h3><p>Stays put, even in a squat.</p></div>
      <div class="scp-feature-card"><h3>100% opaque</h3><p>Zero see-through, squat-tested.</p></div>
      <div class="scp-feature-card"><h3>No annoying seams</h3><p>No chafing, no pinching.</p></div>
      <div class="scp-feature-card"><h3>Breathable</h3><p>Wicks moisture, dries fast.</p></div>
    </div>
  </section>

  <!--
    NOTE: no outdoor/"walking in the city" photo available among the
    supplied visuals — beige colorway used here in the meantime.
  -->
  <section class="scp-chapter">
    <div class="scp-chapter-media"><img src="{{ 'sculptia-colorway-beige.jpg' | asset_url }}" alt="" loading="lazy"></div>
    <div class="scp-chapter-copy">
      <p class="scp-eyebrow scp-accent">EVERYDAY WEAR</p>
      <h2>From workouts to everyday life</h2>
      <p>Wear it with sneakers or boots, from morning yoga to Sunday brunch.</p>
      <div class="scp-tag-row">
        <span class="scp-tag">WORKOUT</span><span class="scp-tag">OFFICE</span><span class="scp-tag">TRAVEL</span><span class="scp-tag">CITY</span>
      </div>
    </div>
  </section>

  <section class="scp-material">
    <h2>Sculpting without sacrificing comfort</h2>
    <p>{{ section.settings.material_text | default: "70% nylon, 30% spandex — a second-skin fabric you'll forget you're wearing." }}</p>
  </section>

  <section class="scp-final-cta">
    <h2>Ready to reveal your shape?</h2>
    <p>Buy 2 get 1 FREE today · Free shipping over $65 · 30-day refund</p>
    <a class="scp-cta scp-light" href="#scp-top">CHOOSE MY BUNDLE</a>
  </section>

  <section class="scp-reviews" id="scp-reviews">
    <h2>Loved by over 7,000 women</h2>
    <div class="scp-review-summary">
      <div class="scp-review-avg">{{ section.settings.review_average | default: 4.7 }}</div>
      <div class="scp-stars" id="scp-stars-summary" style="justify-content:center;margin-top:6px;"></div>
      <div class="scp-review-count">{{ section.settings.review_count | default: 355 }} verified reviews</div>
      <div class="scp-review-bars" id="scp-review-bars"></div>
    </div>
    <div id="scp-review-list"></div>
    <p class="scp-review-note">{{ section.settings.review_note | default: "More Sculptia customer reviews will be added over time." }}</p>
  </section>

  <section class="scp-faq" id="scp-faq-list">
    <h2>Frequently Asked Questions</h2>
    {%- for block in section.blocks -%}
      {%- if block.type == 'faq' -%}
      <div class="scp-faq-item{% if forloop.first %} scp-open{% endif %}">
        <button class="scp-faq-q" type="button"><span>{{ block.settings.question }}</span><span class="scp-icon">{% if forloop.first %}−{% else %}+{% endif %}</span></button>
        <div class="scp-faq-a">{{ block.settings.answer }}</div>
      </div>
      {%- endif -%}
    {%- endfor -%}
  </section>

  <div class="scp-sticky-cta">
    <button class="scp-cta" id="scp-cta-sticky" type="button" style="margin-top:0;">ADD TO CART · <span class="scp-num" id="scp-cta-price-sticky"></span></button>
    <p class="scp-cta-note" id="scp-cta-note-sticky"></p>
  </div>
</div>

<script>
  window.__SCP_PRODUCT__ = {{ product | json }};
  window.__SCP_MONEY_FORMAT__ = {{ shop.money_format | json }};
</script>
{{ 'sculptia-product.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Sculptia — Product Page",
  "settings": [
    { "type": "header", "content": "Banner & badges" },
    { "type": "text", "id": "announcement", "label": "Announcement bar" },
    { "type": "text", "id": "badge_text", "label": "Product badge", "default": "Best-Seller" },
    { "type": "text", "id": "urgency_text", "label": "Urgency text" },
    { "type": "header", "content": "Benefits (one per line)" },
    {
      "type": "textarea",
      "id": "benefit_bullets",
      "label": "Benefit bullets",
      "default": "Visibly reduces cellulite faster\nTones your legs effortlessly\nLifts and shapes your butt instantly\nSquat-proof, zero see-through"
    },
    { "type": "header", "content": "Promise" },
    { "type": "text", "id": "promise_title", "label": "Title" },
    { "type": "textarea", "id": "promise_text", "label": "Text" },
    { "type": "header", "content": "Material" },
    { "type": "textarea", "id": "material_text", "label": "Material text" },
    { "type": "header", "content": "Reviews" },
    { "type": "number", "id": "review_average", "label": "Average rating", "default": 4.7 },
    { "type": "number", "id": "review_count", "label": "Number of reviews", "default": 355 },
    { "type": "text", "id": "review_note", "label": "Note below reviews" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sculptia — Product Page",
      "blocks": [
        { "type": "faq", "settings": { "question": "Can you see through it when I squat?", "answer": "<p>No. The 3D compressive mesh is fully opaque and squat-proof, even in light colors.</p>" } },
        { "type": "faq", "settings": { "question": "How does it fit? What size should I get?", "answer": "<p>It runs true to size from XS to XXL. Between two sizes, size down for more compression.</p>" } },
        { "type": "faq", "settings": { "question": "When will I see results?", "answer": "<p>Instant lift on day 1. Firmer-looking skin by week 2. Visibly smoother by week 4 of regular wear.</p>" } },
        { "type": "faq", "settings": { "question": "Shipping & returns?", "answer": "<p>Free shipping on orders over $65. Free returns and exchanges within 30 days if it's not right for you.</p>" } }
      ]
    }
  ]
}
{% endschema %}

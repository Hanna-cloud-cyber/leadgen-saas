{{ 'sculptia-product.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;900&family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

{%- assign color_option_index = -1 -%}
{%- assign size_option_index = -1 -%}
{%- for opt in product.options_with_values -%}
  {%- assign opt_name_down = opt.name | downcase -%}
  {%- if opt_name_down contains 'couleur' or opt_name_down contains 'color' -%}
    {%- assign color_option_index = forloop.index0 -%}
  {%- endif -%}
  {%- if opt_name_down contains 'taille' or opt_name_down contains 'size' -%}
    {%- assign size_option_index = forloop.index0 -%}
  {%- endif -%}
{%- endfor -%}

<div class="scp-root" id="scp-root"
     data-color-option-index="{{ color_option_index }}"
     data-size-option-index="{{ size_option_index }}"
     data-product-handle="{{ product.handle }}">

  <div class="scp-announce">{{ section.settings.announcement | default: "LIVRAISON OFFERTE DÈS 49€ · 2 ACHETÉS + 1 OFFERT — AUJOURD'HUI SEULEMENT" }}</div>

  <section class="scp-hero" id="scp-top">
    <div>
      <div class="scp-gallery-main"><img id="scp-gallery-main-img" src="{{ 'sculptia-colorway-black.jpg' | asset_url }}" alt="{{ product.title }}"></div>
      <div class="scp-gallery-thumbs" id="scp-gallery-thumbs"></div>
    </div>
    <div>
      <span class="scp-badge">{{ section.settings.badge_text | default: "Best-seller" }}</span>
      <h1 class="scp-title">{{ product.title }}</h1>

      <div class="scp-rating-row">
        <div class="scp-stars" id="scp-stars-hero"></div>
        <span class="scp-rating-num">{{ section.settings.review_average | default: 4.7 }}</span>
        <a class="scp-rating-link" href="#scp-avis">({{ section.settings.review_count | default: 355 }} avis)</a>
      </div>

      <div class="scp-price-row">
        <span class="scp-price-now scp-num" id="scp-price-now">{{ product.selected_or_first_available_variant.price | money }}</span>
        {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
          <span class="scp-price-was" id="scp-price-was">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
          <span class="scp-price-save" id="scp-price-save"></span>
        {%- endif -%}
      </div>

      <ul class="scp-bullets">
        {%- for line in section.settings.benefit_bullets | newline_to_br | split: '<br />' -%}
          {%- assign trimmed = line | strip -%}
          {%- if trimmed != blank -%}<li><span class="scp-check">✓</span>{{ trimmed }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if color_option_index > -1 -%}
      <div class="scp-field">
        <span class="scp-field-label">{{ product.options[color_option_index] | upcase }} : <b id="scp-color-label"></b></span>
        <div class="scp-color-row" id="scp-color-row"></div>
      </div>
      {%- endif -%}

      {%- if size_option_index > -1 -%}
      <div class="scp-field">
        <span class="scp-field-label">{{ product.options[size_option_index] | upcase }} : <b id="scp-size-label"></b></span>
        <div class="scp-size-row" id="scp-size-row"></div>
      </div>
      {%- endif -%}

      <div class="scp-urgency">{{ section.settings.urgency_text | default: "L'OFFRE SE TERMINE CE SOIR" }} <span class="scp-dot">·</span> <span class="scp-num" id="scp-countdown">29:35</span></div>

      <div class="scp-bundles" id="scp-bundles"></div>

      <button class="scp-cta" id="scp-cta-main" type="button">
        AJOUTER AU PANIER · <span class="scp-num" id="scp-cta-price"></span>
      </button>
      <p class="scp-microcopy" id="scp-stock-note">En stock · Livraison offerte · Remboursé 30 jours</p>

      <div class="scp-trust-row">
        <div>{% render 'scp-icon-truck' %}Livraison offerte 49€+</div>
        <div>{% render 'scp-icon-return' %}Retours 30 jours</div>
        <div>{% render 'scp-icon-shield' %}Paiement sécurisé</div>
      </div>
    </div>
  </section>

  <section class="scp-promise">
    <p class="scp-eyebrow">LA PROMESSE {{ shop.name | upcase }}</p>
    <h2>{{ section.settings.promise_title | default: "Sublime ta silhouette" }}</h2>
    <p>{{ section.settings.promise_text | default: "Un seul legging pour tout changer : il gaine, lifte et lisse dès la première minute." }}</p>
  </section>

  <section class="scp-infographics">
    {%- if section.settings.infographic_1 != blank -%}
      <div class="scp-infographic-frame"><img src="{{ section.settings.infographic_1 | image_url: width: 900 }}" alt="" loading="lazy"></div>
    {%- else -%}
      <div class="scp-infographic-frame"><img src="{{ 'sculptia-infographic-goodbye-cellulite.jpg' | asset_url }}" alt="" loading="lazy"></div>
    {%- endif -%}
    {%- if section.settings.infographic_2 != blank -%}
      <div class="scp-infographic-frame"><img src="{{ section.settings.infographic_2 | image_url: width: 900 }}" alt="" loading="lazy"></div>
    {%- else -%}
      <div class="scp-infographic-frame"><img src="{{ 'sculptia-infographic-drainage-lines-rebrand.jpg' | asset_url }}" alt="" loading="lazy"></div>
    {%- endif -%}
    {%- if section.settings.infographic_3 != blank -%}
      <div class="scp-infographic-frame"><img src="{{ section.settings.infographic_3 | image_url: width: 900 }}" alt="" loading="lazy"></div>
    {%- else -%}
      <div class="scp-infographic-frame"><img src="{{ 'sculptia-infographic-high-waist-tummy-control.jpg' | asset_url }}" alt="" loading="lazy"></div>
    {%- endif -%}
  </section>

  <section class="scp-chapter">
    <div class="scp-chapter-media"><img src="{{ 'sculptia-colorway-black.jpg' | asset_url }}" alt="" loading="lazy"></div>
    <div class="scp-chapter-copy">
      <p class="scp-eyebrow scp-accent">LE RÉSULTAT</p>
      <h2>Une silhouette visuellement plus galbée</h2>
      <p>La ceinture haute gaine le ventre, les panneaux arrière relèvent les fessiers et la compression affine les cuisses. Le miroir répond avant même la salle de sport.</p>
      <ul class="scp-bullets">
        <li><span class="scp-check">✓</span>Taille visuellement affinée</li>
        <li><span class="scp-check">✓</span>Fessiers relevés et rebondis</li>
        <li><span class="scp-check">✓</span>Cuisses lissées, sans marques</li>
      </ul>
    </div>
  </section>

  <section class="scp-chapter scp-reverse">
    <div class="scp-chapter-media"><img src="{{ 'sculptia-lifestyle-yoga.jpg' | asset_url }}" alt="" loading="lazy"></div>
    <div class="scp-chapter-copy">
      <p class="scp-eyebrow scp-accent">LE MÉCANISME</p>
      <h2>Sa structure 3D fait la différence</h2>
      <ul class="scp-rich-bullets">
        <li><b>Maille nid d'abeille.</b> <span>Des milliers d'alvéoles en relief épousent la peau et créent un micro-massage à chaque pas.</span></li>
        <li><b>Panneaux contournés.</b> <span>Découpés en 3D, ils soutiennent les fessiers comme une main invisible.</span></li>
        <li><b>Compression graduée.</b> <span>Plus ferme au ventre et aux cuisses, plus souple aux genoux pour garder une liberté totale.</span></li>
      </ul>
    </div>
  </section>

  <section class="scp-chapter">
    <div class="scp-chapter-media"><img src="{{ 'sculptia-lifestyle-couch.jpg' | asset_url }}" alt="" loading="lazy"></div>
    <div class="scp-chapter-copy">
      <p class="scp-eyebrow scp-accent">LA PEAU</p>
      <h2>Une peau à l'apparence plus lisse</h2>
      <p>À chaque mouvement, le relief de la maille stimule la surface de la peau et active la circulation. Porté régulièrement, l'aspect peau d'orange s'estompe visiblement.</p>
    </div>
  </section>

  <div class="scp-timeline">
    <div class="scp-timeline-row">
      <div class="scp-timeline-step"><div class="t">Jour 1</div><div class="d">Effet lift immédiat</div></div>
      <div class="scp-timeline-step"><div class="t">2 sem.</div><div class="d">Peau plus tonique</div></div>
      <div class="scp-timeline-step"><div class="t">4 sem.</div><div class="d">Aspect plus lisse</div></div>
    </div>
  </div>

  <section class="scp-features">
    <div class="scp-feature-grid">
      <div class="scp-feature-card"><h3>Ne roule jamais</h3><p>La ceinture large reste en place, même en squat.</p></div>
      <div class="scp-feature-card"><h3>100&nbsp;% opaque</h3><p>Testé squat&nbsp;: aucune transparence, même en clair.</p></div>
      <div class="scp-feature-card"><h3>Sans coutures gênantes</h3><p>Pas de frottement, pas de pincement.</p></div>
      <div class="scp-feature-card"><h3>Respirant</h3><p>Évacue l'humidité et sèche vite.</p></div>
    </div>
  </section>

  <section class="scp-chapter">
    <div class="scp-chapter-media"><img src="{{ 'sculptia-colorway-black.jpg' | asset_url }}" alt="" loading="lazy"></div>
    <div class="scp-chapter-copy">
      <p class="scp-eyebrow scp-accent">AU QUOTIDIEN</p>
      <h2>Du sport à la vie de tous les jours</h2>
      <p>Yoga du matin, courses de midi, brunch du dimanche&nbsp;: il se porte avec des baskets comme avec des bottes. Un seul legging, toutes vos journées.</p>
      <div class="scp-tag-row">
        <span class="scp-tag">SPORT</span><span class="scp-tag">BUREAU</span><span class="scp-tag">VOYAGE</span><span class="scp-tag">VILLE</span>
      </div>
    </div>
  </section>

  <section class="scp-material">
    <h2>Sculptant sans sacrifier le confort</h2>
    <p>{{ section.settings.material_text | default: "70 % polyamide, 30 % élasthanne : une matière seconde peau qui s'oublie une fois enfilée." }}</p>
  </section>

  <section class="scp-final-cta">
    <h2>Prête à révéler votre silhouette&nbsp;?</h2>
    <p>2 achetés + 1 OFFERT aujourd'hui · Livraison offerte dès 49€ · Remboursé 30 jours</p>
    <a class="scp-cta scp-light" href="#scp-top">CHOISIR MON OFFRE</a>
  </section>

  <section class="scp-reviews" id="scp-avis">
    <h2>Adoré par plus de 7000 femmes</h2>
    <div class="scp-review-summary">
      <div class="scp-review-avg">{{ section.settings.review_average | default: 4.7 }}</div>
      <div class="scp-stars" id="scp-stars-summary" style="justify-content:center;margin-top:6px;"></div>
      <div class="scp-review-count">{{ section.settings.review_count | default: 355 }} avis vérifiés</div>
      <div class="scp-review-bars" id="scp-review-bars"></div>
    </div>
    {%- if section.settings.review_quote != blank -%}
    <div class="scp-review-quote">
      <div class="scp-stars" id="scp-stars-quote"></div>
      <p>&ldquo;{{ section.settings.review_quote }}&rdquo;</p>
    </div>
    {%- endif -%}
    <p class="scp-review-note">{{ section.settings.review_note | default: "D'autres avis clients seront ajoutés ici." }}</p>
  </section>

  <section class="scp-faq" id="scp-faq-list">
    <h2>Questions fréquentes</h2>
    {%- for block in section.blocks -%}
      {%- if block.type == 'faq' -%}
      <div class="scp-faq-item{% if forloop.first %} scp-open{% endif %}">
        <button class="scp-faq-q" type="button"><span>{{ block.settings.question }}</span><span class="scp-icon">{% if forloop.first %}−{% else %}+{% endif %}</span></button>
        <div class="scp-faq-a">{{ block.settings.answer }}</div>
      </div>
      {%- endif -%}
    {%- endfor -%}
  </section>

  <div class="scp-sticky-cta">
    <button class="scp-cta" id="scp-cta-sticky" type="button" style="margin-top:0;">AJOUTER AU PANIER · <span class="scp-num" id="scp-cta-price-sticky"></span></button>
  </div>
</div>

<script>
  window.__SCP_PRODUCT__ = {{ product | json }};
  window.__SCP_MONEY_FORMAT__ = {{ shop.money_format | json }};
</script>
{{ 'sculptia-product.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Sculptia — Page produit",
  "settings": [
    { "type": "header", "content": "Bandeau & badges" },
    { "type": "text", "id": "announcement", "label": "Bandeau d'annonce" },
    { "type": "text", "id": "badge_text", "label": "Badge produit", "default": "Best-seller" },
    { "type": "text", "id": "urgency_text", "label": "Texte urgence" },
    { "type": "header", "content": "Bénéfices (un par ligne)" },
    {
      "type": "textarea",
      "id": "benefit_bullets",
      "label": "Bullets bénéfices",
      "default": "Réduit visiblement la cellulite plus vite\nTonne vos jambes sans effort\nLift et galbe les fesses instantanément\nAnti-transparence, testé squat"
    },
    { "type": "header", "content": "Promesse" },
    { "type": "text", "id": "promise_title", "label": "Titre" },
    { "type": "textarea", "id": "promise_text", "label": "Texte" },
    { "type": "header", "content": "Infographies (image_picker — sinon visuels par défaut)" },
    { "type": "image_picker", "id": "infographic_1", "label": "Infographie 1" },
    { "type": "image_picker", "id": "infographic_2", "label": "Infographie 2" },
    { "type": "image_picker", "id": "infographic_3", "label": "Infographie 3" },
    { "type": "header", "content": "Matière" },
    { "type": "textarea", "id": "material_text", "label": "Texte matière" },
    { "type": "header", "content": "Avis" },
    { "type": "number", "id": "review_average", "label": "Note moyenne", "default": 4.7 },
    { "type": "number", "id": "review_count", "label": "Nombre d'avis", "default": 355 },
    { "type": "textarea", "id": "review_quote", "label": "Avis mis en avant" },
    { "type": "text", "id": "review_note", "label": "Note sous les avis" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Réponse" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sculptia — Page produit",
      "blocks": [
        { "type": "faq", "settings": { "question": "Est-ce qu'on voit à travers quand je squatte ?", "answer": "<p>Non. La maille 3D compressive est entièrement opaque et anti-transparence, même dans les couleurs claires — testé squat.</p>" } },
        { "type": "faq", "settings": { "question": "Comment taille-t-il ? Quelle taille choisir ?", "answer": "<p>Il taille normalement du XS au XXL. Entre deux tailles, prenez la plus petite pour plus de compression.</p>" } },
        { "type": "faq", "settings": { "question": "Au bout de combien de temps verrai-je des résultats ?", "answer": "<p>Effet lift dès le premier jour. Peau plus tonique dès 2 semaines. Aspect plus lisse après 4 semaines d'utilisation régulière.</p>" } },
        { "type": "faq", "settings": { "question": "Livraison & retours ?", "answer": "<p>Livraison offerte dès 49€ d'achat. Retours et échanges gratuits sous 30 jours si le produit ne vous convient pas.</p>" } }
      ]
    }
  ]
}
{% endschema %}

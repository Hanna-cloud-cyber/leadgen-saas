<section id="faq" class="dw-faq">
  <div class="dw-narrow">
    <h2 class="dw-serif dw-gold">{{ section.settings.heading | escape }}</h2>
    <div class="dw-faq__list">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }}<span aria-hidden="true">+</span></summary>
          <p>{{ block.settings.answer | escape }}</p>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "FAQ" }],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}

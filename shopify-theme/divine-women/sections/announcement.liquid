{%- if section.settings.text != blank -%}
  <div class="dw-announce dw-pill">
    {{ section.settings.text | escape }}
    {%- if section.settings.strike != blank %} <s>{{ section.settings.strike | escape }}</s>{% endif %}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Fall Special: $39 instead of" },
    { "type": "text", "id": "strike", "label": "Struck-through price", "default": "$66" }
  ]
}
{% endschema %}

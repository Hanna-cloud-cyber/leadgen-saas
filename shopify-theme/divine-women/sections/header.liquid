<header class="dw-header">
  <div class="dw-wrap dw-header__inner">
    <a href="{{ routes.root_url }}" class="dw-logo">
      <span class="dw-gold">{{ section.settings.logo_gold | escape }} </span><span class="dw-rose">{{ section.settings.logo_rose | escape }}</span>
    </a>
    <nav class="dw-nav" aria-label="Main">
      <a href="{{ routes.root_url }}#faq">FAQ</a>
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "logo_gold", "label": "Logo (gold part)", "default": "DIVINE" },
    { "type": "text", "id": "logo_rose", "label": "Logo (rose part)", "default": "WOMEN" }
  ]
}
{% endschema %}

{%- liquid
  assign product = section.settings.product
  if product == blank
    assign product = collections.all.products.first
  endif
  capture buy_url
    render 'divine-buy-url', product: product
  endcapture
  assign buy_label = section.settings.button_label
  if product
    assign price_label = product.price | money_without_trailing_zeros
    assign buy_label = buy_label | append: ' · ' | append: price_label
  endif
-%}
<section class="dw-quiz">
  <script type="application/json" id="dw-quiz-data">{% render 'divine-quiz-data' %}</script>
  <div class="dw-narrow" data-dw-quiz data-buy-url="{{ buy_url | strip }}" data-buy-label="{{ buy_label | escape }}">
    <p class="dw-muted dw-center">Loading the quiz…</p>
  </div>
</section>
<script src="{{ 'divine-quiz.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Archetype quiz",
  "settings": [
    { "type": "product", "id": "product", "label": "Product (the guide)" },
    { "type": "text", "id": "button_label", "label": "Buy button", "default": "Claim Your Golden Ticket" }
  ],
  "presets": [{ "name": "Archetype quiz" }]
}
{% endschema %}

{%- liquid
  assign product = section.settings.product
  if product == blank
    assign product = collections.all.products.first
  endif
  assign buy_url = ''
  if product
    capture buy_url
      render 'divine-buy-url', product: product
    endcapture
  endif
-%}
<section class="dw-hero">
  <div class="dw-narrow">
    <h1 class="dw-sr-only">{{ product.title | default: shop.name }}</h1>

    <div class="dw-book">
      <div class="dw-book__glow"></div>
      <div class="dw-book__body">
        <div class="dw-book__pages"></div>
        <div class="dw-book__cover">
          {%- if section.settings.cover != blank -%}
            {{ section.settings.cover | image_url: width: 900 | image_tag: alt: product.title, loading: 'eager', fetchpriority: 'high' }}
          {%- else -%}
            <img src="{{ 'divine-cover.webp' | asset_url }}" alt="{{ product.title | escape }}" width="1024" height="1536" fetchpriority="high">
          {%- endif -%}
        </div>
      </div>
    </div>

    <div id="buy" class="dw-price">
      {%- if section.settings.promo_label != blank -%}
        <p class="dw-eyebrow" style="color: var(--rose)">{{ section.settings.promo_label | escape }}</p>
      {%- endif -%}
      {%- if product -%}
        <div class="dw-price__row">
          <span class="dw-price__now dw-gold">{{ product.price | money_without_trailing_zeros }}</span>
          {%- if product.compare_at_price > product.price -%}
            <s class="dw-price__was">{{ product.compare_at_price | money_without_trailing_zeros }}</s>
          {%- endif -%}
        </div>
      {%- endif -%}
      <p class="dw-small">{{ section.settings.price_note | escape }}</p>

      <div class="dw-ctas">
        {%- if product -%}
          <a href="{{ buy_url | strip }}" class="dw-btn dw-btn--gold">
            {{ section.settings.button_label | escape }} · {{ product.price | money_without_trailing_zeros }}
            {%- if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>{% endif %}
          </a>
        {%- else -%}
          <p class="dw-small">Choose your product in Customize → Hero.</p>
        {%- endif -%}
      </div>
      <p class="dw-small">{{ section.settings.guarantee | escape }}</p>
    </div>

    <p class="dw-tagline">
      <span>{{ section.settings.tagline_1 | escape }}</span>
      <span class="dw-rose">{{ section.settings.tagline_2 | escape }}</span>
    </p>
  </div>
</section>

{%- if product -%}
  <div class="dw-sticky">
    <a href="{{ buy_url | strip }}" class="dw-btn dw-btn--gold">
      {{ section.settings.button_label | escape }} · {{ product.price | money_without_trailing_zeros }}
      {%- if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>{% endif %}
    </a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Hero (book + price)",
  "settings": [
    { "type": "product", "id": "product", "label": "Product (the guide)" },
    { "type": "image_picker", "id": "cover", "label": "Book cover", "info": "Leave empty to use the built-in cover." },
    { "type": "text", "id": "promo_label", "label": "Promo label", "default": "Fall Special" },
    { "type": "text", "id": "price_note", "label": "Under the price", "default": "One-time payment · Instant PDF download" },
    { "type": "text", "id": "button_label", "label": "Buy button", "default": "Claim Your Golden Ticket" },
    { "type": "text", "id": "guarantee", "label": "Under the buttons", "default": "Secure checkout · 30-day money-back guarantee" },
    { "type": "text", "id": "tagline_1", "label": "Tagline line 1", "default": "Discover your archetype" },
    { "type": "text", "id": "tagline_2", "label": "Tagline line 2", "default": "and unlock your feminine power" }
  ],
  "presets": [{ "name": "Hero (book + price)" }]
}
{% endschema %}

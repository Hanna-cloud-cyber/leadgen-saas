<section class="dw-page dw-center">
  <div class="dw-narrow">
    <div class="dw-logo" style="font-size:28px"><span class="dw-gold">DIVINE </span><span class="dw-rose">WOMEN</span></div>
    <p class="dw-muted" style="margin-top:16px">{{ 'general.password_page.opening_soon' | t }}</p>
    {%- form 'storefront_password', class: 'dw-form', style: 'margin-top:24px' -%}
      {%- if form.errors -%}<div style="color:var(--rose)">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label class="dw-sr-only" for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
      <input class="dw-input" type="password" name="password" id="Password" placeholder="{{ 'general.password_page.login_form_password_label' | t }}">
      <button type="submit" class="dw-btn dw-btn--gold">{{ 'general.password_page.login_form_submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
{% schema %}{ "name": "Password" }{% endschema %}

{%- comment -%} Data for JS: variants + per-color image filenames {%- endcomment -%}
<script type="application/json" id="sculptia-variants-data">
  {{ product.variants | json }}
</script>

<style>
.sculptia { max-width: 100%; color: #161616; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background: #fff; }
.sculptia * { box-sizing: border-box; }
.sculptia img { display: block; max-width: 100%; height: 100%; width: 100%; object-fit: cover; }
.sculptia-announcement { background: #161616; color: #fff; font-size: 12px; font-weight: 600; letter-spacing: 0.03em; text-align: center; padding: 10px 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sculptia-hero { max-width: 1152px; margin: 0 auto; padding: 32px 16px; display: grid; grid-template-columns: 1fr; gap: 40px; }
@media (min-width: 1024px) { .sculptia-hero { grid-template-columns: 1fr 1fr; padding: 32px 24px; } }
.sculptia-gallery-main { aspect-ratio: 4 / 5; background: #f5f5f5; overflow: hidden; border-radius: 2px; }
.sculptia-gallery-main img { object-fit: contain; }
.sculptia-gallery-thumbs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-top: 8px; }
.sculptia-gallery-thumbs button { aspect-ratio: 1; background: #f5f5f5; border: 2px solid transparent; border-radius: 2px; padding: 0; overflow: hidden; cursor: pointer; }
.sculptia-gallery-thumbs button.is-selected { border-color: #161616; }
.sculptia-gallery-thumbs img { object-fit: contain; }
.sculptia-badge { display: inline-block; background: #161616; color: #fff; font-size: 11px; font-weight: 700; letter-spacing: 0.05em; padding: 4px 12px; margin-bottom: 16px; }
.sculptia-title { font-size: 24px; font-weight: 900; text-transform: uppercase; line-height: 1.15; letter-spacing: -0.01em; margin: 0; }
@media (min-width: 640px) { .sculptia-title { font-size: 30px; } }
.sculptia-rating { display: flex; align-items: center; gap: 8px; margin-top: 12px; font-size: 14px; }
.sculptia-rating a { color: #737373; text-decoration: underline; }
.sculptia-stars { color: #161616; letter-spacing: 2px; }
.sculptia-rating-num { font-weight: 600; }
.sculptia-price-row { display: flex; align-items: center; gap: 12px; margin-top: 16px; }
.sculptia-price { font-size: 30px; font-weight: 900; }
.sculptia-compare-at { font-size: 18px; color: #a3a3a3; text-decoration: line-through; }
.sculptia-save { background: #f5f5f5; font-size: 12px; font-weight: 700; padding: 4px 8px; }
.sculptia-option-group { margin-top: 20px; }
.sculptia-option-label { font-size: 12px; font-weight: 700; letter-spacing: 0.02em; }
.sculptia-option-label span { font-weight: 400; color: #525252; }
.sculptia-swatches { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
.sculptia-swatch { width: 36px; height: 36px; border-radius: 50%; border: 2px solid transparent; box-shadow: 0 0 0 1px #e5e5e5; cursor: pointer; padding: 0; }
.sculptia-swatch.is-selected { border-color: #161616; }
.sculptia-sizes { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; margin-top: 8px; }
.sculptia-size-btn { padding: 8px 0; font-size: 14px; font-weight: 600; border: 1px solid #d4d4d4; background: #fff; cursor: pointer; }
.sculptia-size-btn.is-selected { background: #161616; color: #fff; border-color: #161616; }
.sculptia-bullets { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
.sculptia-bullets li { font-size: 15px; }
.sculptia-urgency { margin-top: 20px; background: #f5f5f5; text-align: center; padding: 12px; font-size: 14px; font-weight: 600; }
.sculptia-countdown { font-family: monospace; font-weight: 700; }
.sculptia-bundles { margin-top: 16px; display: flex; flex-direction: column; gap: 8px; }
.sculptia-bundle { position: relative; width: 100%; text-align: left; border: 1px solid #e5e5e5; padding: 16px; display: flex; align-items: flex-start; gap: 12px; background: #fff; cursor: pointer; }
.sculptia-bundle.is-selected { border-color: #161616; background: #fafafa; }
.sculptia-bundle-flag { position: absolute; top: -12px; right: 12px; background: #161616; color: #fff; font-size: 10px; font-weight: 700; padding: 4px 8px; }
.sculptia-bundle-dot { margin-top: 4px; width: 16px; height: 16px; border-radius: 50%; border: 2px solid #d4d4d4; flex-shrink: 0; }
.sculptia-bundle.is-selected .sculptia-bundle-dot { border-color: #161616; background: #161616; }
.sculptia-bundle-mid { flex: 1; }
.sculptia-bundle-label { display: block; font-weight: 700; font-size: 14px; }
.sculptia-bundle-sub { display: block; font-size: 12px; color: #737373; }
.sculptia-bundle-save { display: block; font-size: 12px; color: #737373; margin-top: 4px; }
.sculptia-bundle-price { text-align: right; }
.sculptia-bundle-price .sculptia-bp-now { display: block; font-weight: 900; }
.sculptia-bundle-price .sculptia-bp-was { display: block; font-size: 12px; color: #a3a3a3; text-decoration: line-through; }
.sculptia-add-btn { width: 100%; background: #161616; color: #fff; font-weight: 700; letter-spacing: 0.02em; padding: 16px; margin-top: 20px; border: none; cursor: pointer; }
.sculptia-add-btn:disabled { opacity: 0.6; cursor: default; }
.sculptia-error { text-align: center; font-size: 12px; color: #dc2626; margin-top: 6px; }
.sculptia-bundle-note { text-align: center; font-size: 12px; color: #a3a3a3; margin-top: 6px; }
.sculptia-instock { text-align: center; font-size: 12px; color: #737373; margin-top: 8px; }
.sculptia-trust-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 20px; padding-top: 20px; border-top: 1px solid #e5e5e5; text-align: center; font-size: 11px; color: #525252; }
.sculptia-dark { background: #161616; color: #fff; text-align: center; padding: 56px 16px; }
.sculptia-eyebrow-light { font-size: 11px; letter-spacing: 0.25em; font-weight: 700; color: #a3a3a3; }
.sculptia-promise h2, .sculptia-final-cta h2 { font-size: 28px; font-weight: 900; text-transform: uppercase; margin: 8px 0 0; }
@media (min-width: 640px) { .sculptia-promise h2, .sculptia-final-cta h2 { font-size: 36px; } }
.sculptia-promise-text { max-width: 420px; margin: 12px auto 0; color: #d4d4d4; font-size: 15px; }
.sculptia-row { max-width: 1024px; margin: 0 auto; padding: 48px 16px; display: grid; grid-template-columns: 1fr; gap: 32px; align-items: center; }
@media (min-width: 768px) { .sculptia-row { grid-template-columns: 1fr 1fr; padding: 56px 24px; } .sculptia-row-reverse .sculptia-row-image { order: 2; } .sculptia-row-reverse .sculptia-row-copy { order: 1; } }
.sculptia-row-image { aspect-ratio: 4/5; background: #f5f5f5; overflow: hidden; }
.sculptia-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.2em; color: #a3a3a3; }
.sculptia-row-copy h2 { font-size: 20px; font-weight: 900; text-transform: uppercase; margin: 8px 0 0; line-height: 1.2; }
@media (min-width: 640px) { .sculptia-row-copy h2 { font-size: 28px; } }
.sculptia-row-copy p { color: #737373; margin-top: 14px; }
.sculptia-check-list, .sculptia-rich-list { list-style: none; padding: 0; margin: 14px 0 0; display: flex; flex-direction: column; gap: 8px; font-size: 15px; }
.sculptia-rich-list li { color: #525252; }
.sculptia-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
.sculptia-tags span { border: 1px solid #d4d4d4; padding: 8px 16px; font-size: 12px; font-weight: 600; }
.sculptia-timeline { max-width: 896px; margin: 0 auto; padding: 40px 16px; display: grid; grid-template-columns: repeat(3, 1fr); text-align: center; gap: 16px; border-top: 1px solid #e5e5e5; }
.sculptia-timeline-t { font-size: 20px; font-weight: 900; }
.sculptia-timeline-d { font-size: 14px; color: #737373; margin-top: 4px; }
.sculptia-features { background: #fafafa; padding: 64px 16px; }
.sculptia-features-grid { max-width: 960px; margin: 0 auto; display: grid; grid-template-columns: 1fr; gap: 16px; }
@media (min-width: 640px) { .sculptia-features-grid { grid-template-columns: 1fr 1fr; } }
.sculptia-feature-card { background: #fff; border: 1px solid #e5e5e5; padding: 24px; }
.sculptia-feature-card h3 { margin: 0; font-weight: 700; }
.sculptia-feature-card p { margin: 4px 0 0; color: #737373; font-size: 14px; }
.sculptia-material { max-width: 720px; margin: 0 auto; padding: 48px 16px; text-align: center; border-top: 1px solid #e5e5e5; }
.sculptia-material h2 { font-size: 22px; font-weight: 900; text-transform: uppercase; margin: 0; }
.sculptia-material p { color: #737373; margin-top: 12px; }
.sculptia-final-cta p { color: #d4d4d4; margin-top: 12px; font-size: 14px; }
.sculptia-cta-btn { display: inline-block; background: #fff; color: #161616; font-weight: 700; padding: 16px 32px; margin-top: 24px; text-decoration: none; }
.sculptia-reviews { max-width: 720px; margin: 0 auto; padding: 64px 16px; }
.sculptia-reviews h2 { text-align: center; font-size: 22px; font-weight: 900; text-transform: uppercase; margin: 0; }
.sculptia-reviews-summary { border: 1px solid #e5e5e5; padding: 24px; margin-top: 32px; text-align: center; }
.sculptia-reviews-avg { font-size: 36px; font-weight: 900; }
.sculptia-stars-lg { font-size: 20px; margin: 8px 0; }
.sculptia-reviews-total { font-size: 14px; color: #737373; }
.sculptia-reviews-bars { margin-top: 28px; display: flex; flex-direction: column; gap: 12px; text-align: left; }
.sculptia-bar-row { display: flex; align-items: center; gap: 12px; font-size: 14px; }
.sculptia-bar-row span:first-child { width: 40px; flex-shrink: 0; font-weight: 600; }
.sculptia-bar-row span:last-child { width: 48px; flex-shrink: 0; text-align: right; color: #737373; }
.sculptia-bar { flex: 1; height: 12px; background: #f5f5f5; border-radius: 6px; overflow: hidden; }
.sculptia-bar div { height: 100%; background: #161616; }
.sculptia-review-list { margin-top: 24px; display: flex; flex-direction: column; gap: 16px; }
.sculptia-review-list blockquote { border: 1px solid #e5e5e5; padding: 24px; margin: 0; }
.sculptia-review-head { display: flex; align-items: center; justify-content: space-between; font-size: 13px; }
.sculptia-review-list p { margin: 12px 0 0; font-size: 15px; }
.sculptia-faq { max-width: 720px; margin: 0 auto; padding: 64px 16px; border-top: 1px solid #e5e5e5; }
.sculptia-faq h2 { font-size: 22px; font-weight: 900; text-transform: uppercase; margin: 0 0 24px; }
.sculptia-faq-list details { border-bottom: 1px solid #e5e5e5; padding: 16px 0; }
.sculptia-faq-list summary { font-weight: 700; cursor: pointer; }
.sculptia-faq-list p { color: #525252; margin: 12px 0 0; font-size: 15px; }
.sculptia-sticky-cta { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; border-top: 1px solid #e5e5e5; padding: 12px; z-index: 40; display: none; }
@media (max-width: 1023px) { .sculptia-sticky-cta { display: block; } .sculptia main { padding-bottom: 76px; } }
</style>

<script>
  window.__sculptiaProductHandle = {{ product.handle | json }};
</script>
<script src="{{ 'sculptia.js' | asset_url }}" defer></script>


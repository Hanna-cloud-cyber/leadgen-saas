{%- comment -%}
  Sculptia 3D Anti-Cellulite Legging — native Shopify (Liquid) product page.
  Assigned via templates/product.sculptia.json to this product only.
  Relies on Dawn's own theme header/footer/cart — this section renders the
  product hero + all marketing content in between.
{%- endcomment -%}

{%- assign selected_variant = product.selected_or_first_available_variant -%}

<div class="sculptia" id="sculptia-top">

  {%- comment -%} Slim announcement bar {%- endcomment -%}
  <div class="sculptia-announcement">
    FREE SHIPPING OVER {{ selected_variant.compare_at_price | default: selected_variant.price | money_without_trailing_zeros }}
    &nbsp;·&nbsp; BUY 2 GET 1 FREE — TODAY ONLY
  </div>

  <main>
    {%- comment -%} Hero: gallery + buy box {%- endcomment -%}
    <section class="sculptia-hero">
      {%- assign selected_color = selected_variant.title | split: ' / ' | first -%}
      {%- case selected_color -%}
        {%- when 'Black' -%}{%- assign default_image = 'sculptia-black.png' -%}
        {%- when 'Heather Grey' -%}{%- assign default_image = 'sculptia-heather-grey.png' -%}
        {%- when 'Beige' -%}{%- assign default_image = 'sculptia-beige.png' -%}
        {%- when 'Navy' -%}{%- assign default_image = 'sculptia-navy.png' -%}
        {%- when 'Dark Olive' -%}{%- assign default_image = 'sculptia-dark-olive.png' -%}
        {%- when 'Hot Pink' -%}{%- assign default_image = 'sculptia-hot-pink.png' -%}
        {%- when 'Light Pink' -%}{%- assign default_image = 'sculptia-light-pink.png' -%}
        {%- when 'Light Blue' -%}{%- assign default_image = 'sculptia-light-blue.png' -%}
        {%- else -%}{%- assign default_image = 'sculptia-black.png' -%}
      {%- endcase -%}
      <div class="sculptia-gallery">
        <div class="sculptia-gallery-main">
          <img id="sculptia-main-image" src="{{ default_image | asset_url }}" alt="{{ product.title }}">
        </div>
        <div class="sculptia-gallery-thumbs" id="sculptia-gallery-thumbs">
          {%- comment -%} filled in by JS based on selected color {%- endcomment -%}
        </div>
      </div>

      <div class="sculptia-buybox">
        <span class="sculptia-badge">BEST-SELLER</span>
        <h1 class="sculptia-title">Sculptia 3D Anti-Cellulite Legging</h1>

        <div class="sculptia-rating">
          <span class="sculptia-stars" aria-label="4.7 out of 5">★★★★★</span>
          <span class="sculptia-rating-num">4.7</span>
          <a href="#sculptia-reviews">(355 reviews)</a>
        </div>

        <div class="sculptia-price-row">
          <span class="sculptia-price" id="sculptia-price">{{ selected_variant.price | money }}</span>
          {%- if selected_variant.compare_at_price > selected_variant.price -%}
            <span class="sculptia-compare-at" id="sculptia-compare-at">{{ selected_variant.compare_at_price | money }}</span>
            <span class="sculptia-save" id="sculptia-save">SAVE {{ selected_variant.compare_at_price | minus: selected_variant.price | times: 100.0 | divided_by: selected_variant.compare_at_price | round }}%</span>
          {%- endif -%}
        </div>

        {%- comment -%} Color selector {%- endcomment -%}
        <div class="sculptia-option-group">
          <span class="sculptia-option-label">COLOR: <span id="sculptia-color-label">{{ selected_variant.title | split: ' / ' | first }}</span></span>
          <div class="sculptia-swatches" id="sculptia-swatches">
            {%- for value in product.options_with_values -%}
              {%- if value.name == 'Color' -%}
                {%- for color in value.values -%}
                  {%- case color -%}
                    {%- when 'Black' -%}{%- assign swatch_hex = '#161616' -%}
                    {%- when 'Heather Grey' -%}{%- assign swatch_hex = '#9a9a9a' -%}
                    {%- when 'Beige' -%}{%- assign swatch_hex = '#d9c9a8' -%}
                    {%- when 'Navy' -%}{%- assign swatch_hex = '#1b2a44' -%}
                    {%- when 'Dark Olive' -%}{%- assign swatch_hex = '#3a3a28' -%}
                    {%- when 'Hot Pink' -%}{%- assign swatch_hex = '#ec2c7d' -%}
                    {%- when 'Light Pink' -%}{%- assign swatch_hex = '#f5c8d6' -%}
                    {%- when 'Light Blue' -%}{%- assign swatch_hex = '#cfe8f5' -%}
                    {%- else -%}{%- assign swatch_hex = '#a3a3a3' -%}
                  {%- endcase -%}
                  <button
                    type="button"
                    class="sculptia-swatch{% if color == selected_color %} is-selected{% endif %}"
                    data-color="{{ color | escape }}"
                    style="background-color: {{ swatch_hex }};"
                    title="{{ color | escape }}"
                    aria-label="{{ color | escape }}"
                  ></button>
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        {%- comment -%} Size selector {%- endcomment -%}
        <div class="sculptia-option-group">
          <span class="sculptia-option-label">SIZE: <span id="sculptia-size-label">{{ selected_variant.title | split: ' / ' | last }}</span></span>
          <div class="sculptia-sizes" id="sculptia-sizes">
            {%- for value in product.options_with_values -%}
              {%- if value.name == 'Size' -%}
                {%- assign selected_size = selected_variant.title | split: ' / ' | last -%}
                {%- for size in value.values -%}
                  <button type="button" class="sculptia-size-btn{% if size == selected_size %} is-selected{% endif %}" data-size="{{ size | escape }}">{{ size }}</button>
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        <ul class="sculptia-bullets">
          <li>✓ Visibly reduces cellulite faster</li>
          <li>✓ Tones your legs effortlessly</li>
          <li>✓ Lifts and shapes your butt instantly</li>
          <li>✓ Squat-proof, zero see-through</li>
        </ul>

        <div class="sculptia-urgency">
          <span>OFFER ENDS TONIGHT</span> · <span id="sculptia-countdown" class="sculptia-countdown">&nbsp;</span>
        </div>

        {%- comment -%} Bundles {%- endcomment -%}
        <div class="sculptia-bundles" id="sculptia-bundles">
          <button type="button" class="sculptia-bundle" data-qty="1" data-free="0">
            <span class="sculptia-bundle-dot"></span>
            <span class="sculptia-bundle-mid">
              <span class="sculptia-bundle-label">1 Legging</span>
              <span class="sculptia-bundle-sub">Try it out</span>
              <span class="sculptia-bundle-save"></span>
            </span>
            <span class="sculptia-bundle-price"></span>
          </button>
          <button type="button" class="sculptia-bundle is-selected" data-qty="2" data-free="1">
            <span class="sculptia-bundle-flag">MOST POPULAR</span>
            <span class="sculptia-bundle-dot"></span>
            <span class="sculptia-bundle-mid">
              <span class="sculptia-bundle-label">Buy 2, Get 1 FREE</span>
              <span class="sculptia-bundle-sub">One to wear, one to wash, one to spare</span>
              <span class="sculptia-bundle-save"></span>
            </span>
            <span class="sculptia-bundle-price"></span>
          </button>
          <button type="button" class="sculptia-bundle" data-qty="3" data-free="2">
            <span class="sculptia-bundle-flag">BEST VALUE</span>
            <span class="sculptia-bundle-dot"></span>
            <span class="sculptia-bundle-mid">
              <span class="sculptia-bundle-label">Buy 3, Get 2 FREE</span>
              <span class="sculptia-bundle-sub">Free shipping included</span>
              <span class="sculptia-bundle-save"></span>
            </span>
            <span class="sculptia-bundle-price"></span>
          </button>
        </div>

        <button type="button" id="sculptia-add-to-cart" class="sculptia-add-btn">ADD TO CART</button>
        <p id="sculptia-cart-error" class="sculptia-error" hidden></p>
        <p class="sculptia-bundle-note" id="sculptia-bundle-note"></p>
        <p class="sculptia-instock">In stock · Free shipping · 30-day refund</p>

        <div class="sculptia-trust-row">
          <div>🚚<br>Free shipping</div>
          <div>↺<br>30-day returns</div>
          <div>🔒<br>Secure checkout</div>
        </div>
      </div>
    </section>

    {%- comment -%} Promise banner {%- endcomment -%}
    <section class="sculptia-dark sculptia-promise">
      <p class="sculptia-eyebrow-light">THE SCULPTIA PROMISE</p>
      <h2>Sculpt Your Silhouette</h2>
      <p class="sculptia-promise-text">One legging changes everything: it shapes, lifts, and smooths from the very first wear.</p>
    </section>

    {%- comment -%} Image/text rows {%- endcomment -%}
    <section class="sculptia-row">
      <div class="sculptia-row-image"><img src="{{ 'sculptia-lifestyle-yoga.png' | asset_url }}" alt="The result" loading="lazy"></div>
      <div class="sculptia-row-copy">
        <p class="sculptia-eyebrow">THE RESULT</p>
        <h2>A visibly more sculpted silhouette</h2>
        <p>The high waistband shapes your tummy, the back panels lift your glutes, and the compression slims your thighs.</p>
        <ul class="sculptia-check-list">
          <li>✓ Visibly slimmer waist</li>
          <li>✓ Lifted, rounder glutes</li>
          <li>✓ Smoother thighs, no marks</li>
        </ul>
      </div>
    </section>

    <section class="sculptia-row sculptia-row-reverse">
      <div class="sculptia-row-image"><img src="{{ 'sculptia-lifestyle-couch.png' | asset_url }}" alt="The mechanism" loading="lazy"></div>
      <div class="sculptia-row-copy">
        <p class="sculptia-eyebrow">THE MECHANISM</p>
        <h2>3D structure makes the difference</h2>
        <ul class="sculptia-rich-list">
          <li><strong>Honeycomb mesh.</strong> Raised cells create a micro-massage with every step.</li>
          <li><strong>Contoured panels.</strong> Lift your glutes like an invisible hand.</li>
